# ============================================
# ODOO CONFIGURATION (SERVER-SIDE ONLY)
# ============================================
# IMPORTANTE: Estas credenciales NUNCA deben usar NEXT_PUBLIC_
# Solo accesibles desde el servidor (API Routes)

ODOO_URL=https://your-odoo-instance.com/jsonrpc
ODOO_DATABASE=your_database_name
ODOO_USER_ID=8
ODOO_API_KEY=your_secure_api_key_here

# ============================================
# ADMIN CREDENTIALS (SERVER-SIDE ONLY)
# ============================================
# Credenciales del administrador del sistema

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ============================================
# APPLICATION SETTINGS (CLIENT-SIDE)
# ============================================
# Estas variables SÍ pueden usar NEXT_PUBLIC_ porque no son sensibles

NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_PROYECTO_ID=1
NEXT_PUBLIC_TAREA_ID=1

# ============================================
# JWT CONFIGURATION (SERVER-SIDE ONLY)
# ============================================
# Generar con: openssl rand -base64 32

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================

# Webhook para registro de tareas (si aplica)
WEBHOOK_URL=https://n8n-n8n.2fsywk.easypanel.host/webhook/hoja_horas

# Redis para cache (opcional)
# REDIS_URL=redis://localhost:6379

# Database para read models (opcional)
# DATABASE_URL=postgresql://user:password@localhost:5432/qr_generator

# ============================================
# SESIÓN Y ENTRADA ÚNICA DESDE LA BILLETERA (SERVER-SIDE ONLY)
# ============================================
# OBLIGATORIA en producción (mínimo 32 caracteres; sin ella las sesiones no funcionan). Generar con: openssl rand -base64 48
SESSION_SECRET=
# Entrada sin contraseña desde la billetera (Servicios -> Asistencia). Registrar en el banco la plataforma "asistencia"
# con «URL de entrada única» = https://<esta-app>/api/auth/sso y copiar aquí su secreto.
WALLET_URL=https://your-odoo-instance.com
WALLET_SSO_APP=asistencia
WALLET_SSO_SECRET=
# WALLET_DB=nombre_de_la_base   (si el Odoo tiene varias bases)
# Cuando el SSO funcione, apagar el login antiguo (la contraseña era el DNI, que no es secreto):
# ALLOW_PASSWORD_LOGIN=false
# El auto-registro público está cerrado; solo se abre a propósito:
# ALLOW_SELF_REGISTER=true

# ============================================
# VARIAS EMPRESAS (cada una con su propio Odoo)
# ============================================
# Si se define, reemplaza a ODOO_URL / ODOO_DATABASE / ODOO_USER_ID / ODOO_API_KEY. Una sola línea de JSON.
# - id: minúsculas, dígitos, - o _ (2 a 30). Se guarda en la sesión: no lo cambies después de tener usuarios.
# - userId / apiKey: usuario de SERVICIO con permisos mínimos de asistencia (no un administrador).
# - obra: false si ese Odoo no tiene el módulo de obra (todos son "employee").
# - campoRol: nombre del campo de rol en hr.employee (por defecto x_obra_role; en Akallpa es "obra_role").
# - vinculoPorCorreo: true solo mientras se cargan los vínculos (ver abajo); es más débil.
# EMPRESAS_JSON=[{"id":"renasur","nombre":"Renasur","url":"https://bot-odoo.2fsywk.easypanel.host/jsonrpc","database":"...","userId":8,"apiKey":"...","obra":true},{"id":"akallpa","nombre":"Akallpa","url":"https://.../jsonrpc","database":"...","userId":8,"apiKey":"...","obra":true}]
#
# VÍNCULO PERSONA <-> EMPLEADO: en cada Odoo, la ficha del empleado (hr.employee) debe tener el campo de texto
# x_billetera_cuenta con el número de cuenta de la billetera (WAL00000007). Lo anota el administrador de ESA empresa:
# esa anotación es la aprobación. Una persona en dos empresas lleva su mismo número en las dos fichas.
